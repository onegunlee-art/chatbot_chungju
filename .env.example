# ─────────────────────────────────────────────
# 충주 AI 챗봇 환경변수 (복사: cp .env.example .env)
# ─────────────────────────────────────────────

# --- LLM (필수) ---
ANTHROPIC_API_KEY=sk-ant-...
CHATBOT_MODEL=claude-opus-5
CHATBOT_EFFORT=high            # low | medium | high | xhigh | max

# --- Database (필수) ---
DATABASE_URL=postgresql://chungju:chungju@localhost:5432/chungju

# --- 임베딩 ---
# local  : BAAI/bge-m3 를 서버에서 직접 구동 (API 키 불필요, 한국어 강함) - 기본값
# voyage : Voyage AI API 사용 (VOYAGE_API_KEY 필요)
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024
# VOYAGE_API_KEY=

# --- 수집 스케줄 ---
INGEST_CRON_HOUR=21            # 매일 저녁 9시
INGEST_CRON_MINUTE=0
TIMEZONE=Asia/Seoul
INGEST_ON_STARTUP=false

# --- 공공데이터포털 (선택) ---
# DATA_GO_KR_SERVICE_KEY=

# --- 운영 ---
LOG_LEVEL=INFO
ADMIN_TOKEN=change-me-please   # /admin/* 호출용 Bearer 토큰
ALLOWED_ORIGINS=http://localhost:8000

# --- 음성 (업체 선정: docs/VOICE_OPTIONS.md) ---
VOICE_PROVIDER=none            # none | elevenlabs | custom
VOICE_CONSENT_ON_FILE=false    # 상용 성우는 true 가능 / 시장님 목소리는 서면 동의 후에만
# VOICE_ENDPOINT=https://<업체 TTS 엔드포인트>
# VOICE_HEADERS={"X-API-KEY": "${VOICE_API_KEY}"}
# VOICE_BODY={"text": "{text}", "speaker": "{voice_id}", "format": "mp3"}
# VOICE_MIME=audio/mpeg
# VOICE_API_KEY=
# VOICE_ID=

# 공직선거법 제82조의8 자동 대응: 선거일을 넣어두면 90일 전부터 음성이 자동으로 꺼집니다.
# ELECTION_DAY=2026-06-03
